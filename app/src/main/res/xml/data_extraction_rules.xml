<?xml version="1.0" encoding="utf-8"?>
<!--
  数据提取规则（dataExtractionRules，API 31+）—— WP-M 生成（04 §1，基础占位）。
  云备份 / 设备迁移：数据库与 DataStore 偏好保持默认（纳入）；排除缓存类文件目录。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="cache/" />
    </device-transfer>
</data-extraction-rules>
